# Marketplace builds need no database server. Runtime data is stored under
# %LOCALAPPDATA%\PortfolioOS by default.
PORTFOLIO_OS_DATA_DIR=
PORTFOLIO_OS_PORT=41731

# Configure AI from the in-app "AI API" dialog. Do not commit a real key.
AI_BASE_URL=https://api.agnes-ai.cn/v1
AI_MODEL=agnes-2.5-flash
AI_VISION_MODEL=agnes-2.5-flash
